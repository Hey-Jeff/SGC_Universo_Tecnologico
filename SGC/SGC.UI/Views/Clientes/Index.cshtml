@model IReadOnlyList<SGC.Abstracciones.DTOs.ClienteDto>
@{
    ViewData["Title"] = "Administración de clientes";
    var filtro = ViewBag.Filtro as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clientes</h2>
    <a asp-action="Crear" class="btn btn-primary">Nuevo cliente</a>
</div>

@if (TempData["Exito"] is string mensajeExito)
{
    <div class="alert alert-success">@mensajeExito</div>
}
@if (TempData["Error"] is string mensajeError)
{
    <div class="alert alert-danger">@mensajeError</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" name="filtro" value="@filtro" class="form-control"
               placeholder="Buscar por identificación, nombre o correo..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Identificación</th>
            <th>Nombre completo</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No hay clientes registrados.</td>
            </tr>
        }
        else
        {
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.Identificacion</td>
                    <td>@cliente.NombreCompleto</td>
                    <td>@cliente.Correo</td>
                    <td>@cliente.Telefono</td>
                    <td>
                        @if (cliente.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@cliente.Id" class="btn btn-sm btn-warning">Editar</a>
                        @if (cliente.Activo)
                        {
                            <form asp-action="Eliminar" asp-route-id="@cliente.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Desea eliminar (inactivar) este cliente?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>