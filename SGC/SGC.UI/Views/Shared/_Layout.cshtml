<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SGC</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">SGC · Universo Tecnológico</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>

                        @* Cada integrante agrega aquí el enlace de su módulo, con el rol que corresponda
                           (Clientes, Equipos, Inventario, Comercial, Servicio técnico, Reportes). *@


                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a>
                        </li>

                        @if (User.IsInRole(Roles.Administrador))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Usuarios y roles</a></li>
                                    <li><a class="dropdown-item" asp-controller="Bitacora" asp-action="Index">Bitácora de acciones</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3 text-white">
                        <span class="small">
                            @User.ObtenerNombre()
                            @foreach (var claimRol in User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role))
                            {
                                <span class="badge text-bg-light ms-1">@claimRol.Value</span>
                            }
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Exito"] is string mensajeExito)
    {
        <script>
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: @Json.Serialize(mensajeExito), showConfirmButton: false, timer: 3500 });
        </script>
    }
    @if (TempData["Error"] is string mensajeError)
    {
        <script>
            Swal.fire({ icon: 'error', title: 'No se pudo completar la acción', text: @Json.Serialize(mensajeError), confirmButtonText: 'Entendido' });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
