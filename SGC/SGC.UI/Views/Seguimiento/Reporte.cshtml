@model IReadOnlyList<TrackingFila>
@{ ViewData["Title"] = "Reporte de tracking"; }
<h1 class="h3">Reporte de tracking de gestiones</h1>
<p class="text-muted">Historial de las gestiones visibles para su rol. El administrador puede consultar todas.</p>
<form asp-action="Reporte" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="gestion" class="form-label">Número de gestión</label>
        <input type="number" id="gestion" name="gestion" min="1" value="@ViewBag.Gestion" class="form-control" />
    </div>
    <div class="col-auto"><button class="btn btn-primary">Filtrar</button> <a asp-action="Reporte" class="btn btn-outline-secondary">Limpiar</a></div>
</form>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Gestión</th><th>Fecha UTC</th><th>Acción</th><th>Usuario</th><th>Anterior</th><th>Nuevo</th><th>Comentario</th></tr></thead>
        <tbody>
        @foreach (var m in Model)
        {
            <tr><td><a asp-action="Detalle" asp-route-id="@m.Gestion">@m.Gestion</a></td><td>@m.Fecha.ToString("g")</td><td>@m.Accion</td><td>@m.Usuario</td><td>@m.EstadoAnterior</td><td>@m.EstadoNuevo</td><td class="text-break">@m.Comentario</td></tr>
        }
        </tbody>
    </table>
</div>
@if (Model.Count == 0) { <p class="text-muted">No hay movimientos para el filtro seleccionado.</p> }
<a asp-action="Index" class="btn btn-secondary">Volver</a>
