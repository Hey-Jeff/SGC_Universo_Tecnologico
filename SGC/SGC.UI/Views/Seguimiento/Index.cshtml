@model IReadOnlyList<CreditoFila>
@{ ViewData["Title"] = "Seguimiento"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Seguimiento de gestiones</h1>
    <a asp-action="Reporte" class="btn btn-outline-primary">Reporte de tracking</a>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Gestión</th><th>Cliente</th><th>Monto (₡)</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Identificacion — @s.Cliente</td>
                <td>@s.Monto.ToString("N2")</td>
                <td>@EstadosCredito.Etiqueta(s.Estado)</td>
                <td><a asp-action="Detalle" asp-route-id="@s.Id" class="btn btn-sm btn-primary">Ver gestión</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.Count == 0) { <p class="text-muted">No hay gestiones disponibles para su rol.</p> }
